// ADD THIS MATCH BLOCK INSIDE your existing
// match /b/{bucket}/o { ... } block.
match /backgrounds/{fileName} {
  allow read: if request.auth != null;
  allow create: if request.auth != null
                 && request.resource.metadata.ownerUid == request.auth.uid;
  allow update: if request.auth != null
                 && request.resource.metadata.ownerUid == request.auth.uid;
  allow delete: if request.auth != null
                 && (resource.metadata.ownerUid == request.auth.uid
                     || request.auth.token.email == "cmcaragon@gmail.com");
}
